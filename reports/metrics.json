  "experiment": {
    "intervention": "48-hour activation nudge: in-app checklist + one push notification prompting a second linked card and a first optimised payment within 48h of signup.",
    "hypothesis": "Pushing activation into the first 48 hours raises D30 retention by at least 3 percentage points.",
    "randomisation": "At signup, 50/50, stratified by acquisition channel.",
    "primary_metric": "D30 retention (any transaction on days 28-30).",
    "guardrails": [
      "Activation rate must not fall by more than 1pp.",
      "No increase in support contacts per 1,000 signups.",
      "No increase in linked-card removals within 30 days."
    ],
    "secondary_metrics": [
      "D7 retention",
      "cards linked by day 7",
      "reward earned in week 1",
      "days to activation (median)"
    ],
    "baseline_d30": 0.1975,
    "mde_pp": 3.0,
    "alpha": 0.05,
    "power": 0.8,
    "n_per_arm": 2915,
    "total_n": 5830,
    "signups_per_week": 200,
    "weeks_to_recruit": 30,
    "srm_check": "Chi-square on allocation counts; stop and investigate if p < 0.001.",
    "decision_rule": "SHIP if all of: (1) D30 uplift >= +3pp, (2) two-sided p < 0.05, (3) activation rate not worse by >1pp, (4) no guardrail breached, (5) no sample-ratio mismatch. KILL if D30 uplift <= 0pp or any guardrail breached. ITERATE (one more variant, same rule) if uplift is between 0 and +3pp. The rule is fixed before launch; it is not renegotiated after seeing results.",
    "causation_note": "The driver ranking in this project is OBSERVATIONAL: activated users retain better, but activation also marks users who were already engaged. Correlation is not causation \u2014 only this randomised test can establish a causal link between causing activation and retention.",
    "mde_5pp_alternative": {
      "mde_pp": 5.0,
      "n_per_arm": 1084,
      "total_n": 2168,
      "weeks_to_recruit": 11,
      "note": "Same design, larger minimum effect: powered for +5pp instead of +3pp. The 3pp design stays the primary; the 5pp variant is the pragmatic fallback if the team cannot wait 30 weeks."
